<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>FluidFences</AssemblyName>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PublishReadyToRun>true</PublishReadyToRun>
		<TieredCompilation>true</TieredCompilation>

		<ApplicationIcon>Assets\FF 256.ico</ApplicationIcon>

		<ApplicationManifest>app.manifest</ApplicationManifest>

		<NoWarn>$(NoWarn);WFAC010</NoWarn>

		<BaseOutputPath>bin\</BaseOutputPath>
		<Title>Fluid.Fences</Title>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<AssemblyTitle>FluidFences</AssemblyTitle>
		<StartupObject>DesktopFences.App</StartupObject>
		<Copyright>2026</Copyright>
		<PackageProjectUrl>https://github.com/Dave-Debugs/Fluid.Fences</PackageProjectUrl>
		<PackageIcon>Assets\FF 256.png</PackageIcon>
		<Description>Fluid Fences is a fast, modern, opensource desktop organization application and Stardock Fences alternative (fencesclone) for Windows 10 and 11. Organize desktop icons, files, and folders into translucent glass desktop fences with tabs, folder portals, auto-organize, and animated themes.</Description>
		<RepositoryUrl>https://github.com/Dave-Debugs/Fluid.Fences</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Desktop organization;desktop;stardock;fencesclone;fences;desktop fences;opensource;fencesalternative;fluid-fences;windows;wpf;icons;hideicons;productivity;organizer</PackageTags>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Company>Dave-Debugs</Company>
		<RootNamespace>DesktopFences</RootNamespace>
		<PackageId>FluidFences</PackageId>
		<Authors>Dave-Debugs</Authors>
		<Product>FluidFences</Product>
		<Version>2.3.5</Version>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="DesktopFences.Tests" />
	</ItemGroup>

	<ItemGroup>

		<EmbeddedResource Include="Themes\Builtin\*.json">
			<LogicalName>DesktopFences.Themes.Builtin.%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>

		<None Update="Assets\Loops\*.mp4">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Assets\morph_icon.mp4">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Assets\animated_icon.mp4">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Assets\easter_rabbit.mp4">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Remove="Assets\FF 256.ico" />
		<None Remove="Assets\FF 256.png" />
		<None Remove="Assets\FF 48.ico" />
		<None Remove="Assets\FF32.ico" />
		<None Remove="Settings Window\BuyMeACoffeeQR.png" />
		<None Remove="Settings Window\FluidFences16BitLogo.png" />
	</ItemGroup>

	<ItemGroup>
		<None Include="LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\BuyMeACoffeeQR.png" />
		<Resource Include="Assets\FF 256.ico" />
		<Resource Include="Assets\FF 256.png">
			<Pack>True</Pack>
			<PackagePath>Assets\</PackagePath>
		</Resource>
		<Resource Include="Assets\FF 48.ico" />
		<Resource Include="Assets\FF32.ico" />
		<Resource Include="Settings Window\FluidFences16BitLogo.png" />
	</ItemGroup>

	<ItemGroup>
		<None Update="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="WPF-UI" Version="4.3.0" />
	</ItemGroup>
</Project>
